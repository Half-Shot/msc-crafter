{
  "name": "@msc-crafter/frontend",
  "version": "0.0.0",
  "description": "Frontend for MSC-crafter",
  "main": "lib/index.js",
  "repository": "https://github.com/Half-Shot/msc-crafter",
  "author": "Half-Shot",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node --env-file=.env ../../node_modules/vite/bin/vite.js dev",
    "start": "yarn dev",
    "build": "node --env-file=.env ../../node_modules/vite/bin/vite.js build",
    "lint:eslint": "eslint src",
    "lint:eslint:apply": "yarn lint:eslint --fix",
    "lint:prettier": "prettier -c src/ index.html vite.config.ts README.md",
    "lint:prettier:apply": "yarn lint:prettier -w",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "lint:apply": "yarn lint:eslint:apply && yarn lint:prettier:apply"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@mantine/hooks": "^8.3.5",
    "@octokit/graphql": "^9.0.2",
    "@preact/preset-vite": "^2.10.2",
    "@wooorm/starry-night": "^3.8.0",
    "classnames": "^2.5.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "highlight.js": "11.11.1",
    "jiti": "^2.6.1",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-highlightjs": "^4.2.0",
    "minisearch": "^7.2.0",
    "preact": "^10.27.2",
    "prettier": "^3.6.2",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.1.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4"
  }
}
